# =====================================================================
# CyberSaarthi — FastAPI ML Inference Service Environment Template
# Copy this file to '.env' in the ml/ directory or set in runtime.
# =====================================================================

# Server Networking
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Model and Taxonomy Configuration
TAXONOMY_VERSION=1.0
MODEL_VERSION=baseline-v1.0
CONFIDENCE_THRESHOLD=0.60

# Model Artifact Paths (relative to ml/ directory)
MODEL_ARTIFACT_PATH=training/artifacts/baseline_model.joblib
VECTORIZER_ARTIFACT_PATH=training/artifacts/tfidf_vectorizer.joblib
METADATA_PATH=training/artifacts/model_metadata.json

# CORS Configuration (Restricted to Spring Boot and Frontend)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000
