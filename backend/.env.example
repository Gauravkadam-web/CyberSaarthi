# =====================================================================
# CyberSaarthi — Spring Boot Backend Environment Template
# Copy this file to '.env' in the backend/ directory or set in environment.
# NEVER commit real credentials, passwords, or production keys.
# =====================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cybersaarthi_dev
DB_USER=postgres
DB_PASSWORD=your_postgres_password_placeholder

# JWT Security Configuration
# Secret key MUST be at least 256 bits (32+ characters / 64 hex characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ML Inference Service (FastAPI) Client Configuration
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_ENABLED=true
ML_CONNECT_TIMEOUT_MS=2000
ML_READ_TIMEOUT_MS=3000
ML_TAXONOMY_VERSION=1.0

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
