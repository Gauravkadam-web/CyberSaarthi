# =====================================================================
# CyberSaarthi — Spring Boot Backend Environment Variables Template
# Copy this file to '.env' or set environment variables in your runtime.
# NEVER commit real credentials or secrets to source control.
# =====================================================================

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cybersaarthi_dev
DB_USER=postgres
DB_PASSWORD=your_secure_password_placeholder

# JWT Security Configuration
# Ensure secret key is at least 256 bits (32+ characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_chars_placeholder_only
JWT_EXPIRATION_MS=86400000

# ML Inference Service (FastAPI) Configuration
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=3000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000
