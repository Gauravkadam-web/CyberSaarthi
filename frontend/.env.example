# =====================================================================
# CyberSaarthi — React (Vite) Web Client Environment Template
# Copy this file to '.env' in the frontend/ directory for local overrides.
# In development (npm run dev), Vite proxies /api directly to localhost:8080.
# =====================================================================

# Local Dev Server Port (default: 3000)
VITE_PORT=3000

# Backend REST API Base URL
# If empty, defaults to '/api/v1' using Vite dev server proxy
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Portal Configuration
VITE_APP_TITLE=CyberSaarthi
VITE_HELPLINE_NUMBER=1930
VITE_OFFICIAL_PORTAL_URL=https://cybercrime.gov.in
