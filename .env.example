# =====================================================================
# CyberSaarthi — Root Master Environment Template
# Unified reference for local development and Docker Compose deployment.
# Copy this file to '.env' in the project root to override settings.
# NEVER commit real credentials, passwords, or production keys.
# =====================================================================

# ---------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ---------------------------------------------------------------------
POSTGRES_DB=cybersaarthi_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_placeholder
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cybersaarthi_dev
DB_USER=postgres
DB_PASSWORD=your_secure_password_placeholder

# ---------------------------------------------------------------------
# 2. Spring Boot Core Backend Configuration
# ---------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# JWT Secret Key (HMAC-SHA256, minimum 256 bits / 32+ characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
# ML Client configuration inside Spring Boot
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_ENABLED=true
ML_CONNECT_TIMEOUT_MS=2000
ML_READ_TIMEOUT_MS=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------
# 3. FastAPI Machine Learning Inference Microservice
# ---------------------------------------------------------------------
ML_HOST=127.0.0.1
ML_PORT=8000
FASTAPI_ENV=development
CONFIDENCE_THRESHOLD=0.60
TAXONOMY_VERSION=1.0

# ---------------------------------------------------------------------
# 4. React (Vite) Frontend Configuration
# ---------------------------------------------------------------------
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api/v1
